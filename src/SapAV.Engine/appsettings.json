{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Sandbox": {
    "Mode": "AppContainer",
    "WorkerCount": 2,
    "RequestTimeout": "00:01:00",
    "WorkerMemoryLimitMegabytes": 1024,
    "WorkerCpuRatePercent": 50,
    "MaxFailuresPerFile": 2
  }
}
