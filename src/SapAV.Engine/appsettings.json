{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Sandbox": {
    "Mode": "AppContainer",
    "WorkerCount": 2,
    "RequestTimeout": "00:01:00",
    "ParseTimeout": "00:00:05",
    "WorkerMemoryLimitMegabytes": 1024,
    "WorkerCpuRatePercent": 50,
    "MaxFailuresPerFile": 2
  },
  "Defender": {
    "QueryTimeout": "00:00:10"
  },
  "VirusTotal": {
    "MaliciousThreshold": 5,
    "SuspiciousThreshold": 3,
    "RealTimeMaxWait": "00:00:00",
    "ScanMaxWait": "00:00:00",
    "ScanReserve": 100,
    "RealTimeOwnerShare": 4
  }
}
