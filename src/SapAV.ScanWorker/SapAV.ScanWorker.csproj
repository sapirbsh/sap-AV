<Project Sdk="Microsoft.NET.Sdk">

  <!--
    B5: the low-privilege scan worker. The engine (SYSTEM) starts it in an AppContainer with no capabilities, inside a
    Job Object, and sends it read-only file handles over anonymous pipes. All file parsing (hash, Authenticode, YARA-X,
    Mark-of-the-Web, heuristics) runs here, never in the engine. Framework-dependent: the shared runtime in
    Program Files\dotnet is readable by AppContainers (ALL APPLICATION PACKAGES), see SapAV.Engine/Sandbox/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Nothing culture-specific runs here, and no ICU load inside the sandbox. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No startup hooks (the engine also passes a minimal environment with DOTNET_EnableDiagnostics=0). -->
    <StartupHookSupport>false</StartupHookSupport>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SapAV.Core\SapAV.Core.csproj" />
  </ItemGroup>

</Project>
