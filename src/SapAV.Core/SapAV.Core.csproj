<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- YARA interop: pointers into memory-mapped views and unmanaged callbacks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test seams (e.g. Sha256Hasher.BeforeReadHook) are internal. -->
    <InternalsVisibleTo Include="SapAV.Core.Tests" />
    <!-- The engine's quarantine (B2) reuses the hardened open (SecureFile / NativeFile) instead of a second copy. -->
    <InternalsVisibleTo Include="SapAV.Engine" />
    <!-- The pipe client's raw-frame test seam (B4 hostile-message tests). -->
    <InternalsVisibleTo Include="SapAV.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- D2: the VirusTotal result cache (same package and version as the engine's C5 scan cache). Private: it doesn't flow to
         the sandboxed scan worker, which never uses the cache; the engine and the tests reference it themselves. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <!-- YARA-X engine: pinned native DLL, downloaded once, hash-verified, copied to the output. -->
  <Import Project="..\..\native\yara-x\YaraX.targets" />

</Project>
