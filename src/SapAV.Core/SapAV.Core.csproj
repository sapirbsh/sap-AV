<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- YARA interop: pointers into memory-mapped views and unmanaged callbacks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test seams (e.g. Sha256Hasher.BeforeReadHook) are internal. -->
    <InternalsVisibleTo Include="SapAV.Core.Tests" />
    <!-- The engine's quarantine (B2) reuses the hardened open (SecureFile / NativeFile) instead of a second copy. -->
    <InternalsVisibleTo Include="SapAV.Engine" />
  </ItemGroup>

  <!-- YARA-X engine: pinned native DLL, downloaded once, hash-verified, copied to the output. -->
  <Import Project="..\..\native\yara-x\YaraX.targets" />

</Project>
