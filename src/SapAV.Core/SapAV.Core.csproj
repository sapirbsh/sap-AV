<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- YARA interop: pointers into memory-mapped views and unmanaged callbacks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dnYara" Version="2.1.0" />
    <PackageReference Include="dnYara.NativePack" Version="2.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test seams (e.g. Sha256Hasher.BeforeReadHook) are internal. -->
    <InternalsVisibleTo Include="SapAV.Core.Tests" />
  </ItemGroup>

</Project>
